    {
      "id": "domain:product-and-inventory-management",
      "type": "domain",
      "name": "產品與庫存管理",
      "summary": "此領域管理 Northwind 產品、產品類別、庫存數量與庫存異動。它提供產品的查詢與生命週期操作，以及盤點和調整庫存的用例。",
      "tags": ["northwind", "產品", "庫存"],
      "complexity": "complex",
      "domainMeta": {
        "entities": ["Product", "Category", "InventoryTransaction", "Supplier"],
        "businessRules": ["產品命令會驗證輸入與參照資料", "庫存調整與盤點會透過各自的命令和驗證器處理"],
        "crossDomainInteractions": ["訂單領域以 Product 與 OrderDetail 連結產品資料", "營運監控使用產品與庫存資料彙整儀表板"]
      }
    },
    {
      "id": "domain:order-management",
      "type": "domain",
      "name": "訂單管理",
      "summary": "此領域提供訂單清單、訂單明細與刪除訂單的用例。Order、OrderDetail 與 Customer 是其核心業務詞彙。",
      "tags": ["northwind", "訂單", "客戶"],
      "complexity": "moderate",
      "domainMeta": {
        "entities": ["Order", "OrderDetail", "Customer", "Shipper"],
        "businessRules": ["讀取訂單時使用 GetOrders 與 GetOrderDetail 查詢", "刪除訂單前會經過 DeleteOrder 命令驗證"],
        "crossDomainInteractions": ["訂單明細與產品資料相連", "營運儀表板彙整訂單相關資訊"]
      }
    },
    {
      "id": "domain:identity-and-administration",
      "type": "domain",
      "name": "身分與管理",
      "summary": "此領域處理帳戶註冊、登入、電子郵件確認、密碼重設、雙因素驗證，以及會員、使用者與角色管理。其模型包含 ApplicationUser、ApplicationRole 與使用者設定檔。",
      "tags": ["身分", "帳戶", "角色"],
      "complexity": "complex",
      "domainMeta": {
        "entities": ["ApplicationUser", "ApplicationRole", "ApplicationUserProfile", "ApplicationUserPasswordHistory"],
