@using CleanArchitecture.Northwind.Application.Common.Interfaces
@model IPaginatedList
<!--要搭配使用 <script src="~/js/pagination.js"></script>-->
<nav>
    <ul class="pagination align-items-center">
        <!-- 第一頁 -->
        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
            <button type="button" class="page-link js-page" data-page="1">&laquo;</button>
        </li>
        <!-- 上一頁 -->
        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
            <button type="button" class="page-link js-page" data-page="@(Model.PageNumber - 1)">&lsaquo;</button>
        </li>

        @if (Model.TotalPages <= 7)
        {
            for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <button type="button" class="page-link js-page" data-page="@i">@i</button>
                </li>
            }
        }
        else
        {
            if (Model.PageNumber <= 3)
            {
                for (int i = 1; i <= Math.Min(4, Model.TotalPages); i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <button type="button" class="page-link js-page" data-page="@i">@i</button>
                    </li>
                }
                <li class="page-item disabled"><span class="page-link">…</span></li>
                <li class="page-item @(Model.TotalPages == Model.PageNumber ? "active" : "")">
                    <button type="button" class="page-link js-page" data-page="@Model.TotalPages">@Model.TotalPages</button>
                </li>
            }
            else if (Model.PageNumber < Model.TotalPages - 3)
            {
                <li class="page-item">
                    <button type="button" class="page-link js-page" data-page="1">1</button>
                </li>
                <li class="page-item disabled"><span class="page-link">…</span></li>

                <li class="page-item">
                    <button type="button" class="page-link js-page" data-page="@(Model.PageNumber - 1)">@((Model.PageNumber - 1))</button>
                </li>
                <li class="page-item active">
                    <button type="button" class="page-link js-page" data-page="@Model.PageNumber">@Model.PageNumber</button>
                </li>
                <li class="page-item">
                    <button type="button" class="page-link js-page" data-page="@(Model.PageNumber + 1)">@((Model.PageNumber + 1))</button>
                </li>

                <li class="page-item disabled"><span class="page-link">…</span></li>
                <li class="page-item @(Model.TotalPages == Model.PageNumber ? "active" : "")">
                    <button type="button" class="page-link js-page" data-page="@Model.TotalPages">@Model.TotalPages</button>
                </li>
            }
            else
            {
                <li class="page-item">
                    <button type="button" class="page-link js-page" data-page="1">1</button>
                </li>
                <li class="page-item disabled"><span class="page-link">…</span></li>

                @for (int i = Math.Max(1, Model.TotalPages - 3); i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <button type="button" class="page-link js-page" data-page="@i">@i</button>
                    </li>
                }
            }
        }

        <!-- 下一頁 -->
        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
            <button type="button" class="page-link js-page" data-page="@(Model.PageNumber + 1)">&rsaquo;</button>
        </li>
        <!-- 最後一頁 -->
        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
            <button type="button" class="page-link js-page" data-page="@Model.TotalPages">&raquo;</button>
        </li>

        <!-- 每頁筆數 -->
        <li class="ms-2">
            <select name="pageSize" class="form-select form-select-sm d-inline w-auto js-page-size">
                @{
                    var sizes = new[] { 10, 20, 50, 100 };
                    foreach (var size in sizes)
                    {
                        <option value="@size" selected="@(size == Model.PageSize ? "selected" : null)">@size</option>
                    }
                }
            </select>
        </li>
    </ul>
</nav>