@inject IAuthorizationService AuthorizationService
@using CleanArchitecture.Northwind.Domain.Constants
@using Microsoft.AspNetCore.Authorization
@{
    var systemAdmin = User.IsInRole(Roles.SystemAdmin);
    var auth = User.IsInRole(Roles.SystemAdmin) || User.IsInRole(Roles.Administrator);
    var canViewOrders = await AuthorizationService.AuthorizeAsync(User, Policies.Orders);
    var canViewProducts = await AuthorizationService.AuthorizeAsync(User, Policies.Products_Read);
    var canViewCategories = await AuthorizationService.AuthorizeAsync(User, Policies.Categories_Read);
    var canViewSuppliers = await AuthorizationService.AuthorizeAsync(User, Policies.Suppliers_Read);
    var canViewDashboard = (await AuthorizationService.AuthorizeAsync(User, "Orders:Read:All")).Succeeded
        && (await AuthorizationService.AuthorizeAsync(User, "Products:Read:All")).Succeeded;
}
<nav id="sidebar" class="active">
    <div class="sidebar-header">
        <img src="~/images/bootstraper-logo.png" alt="bootraper logo" class="app-logo">
    </div>
    <ul class="list-unstyled components text-secondary">
        <li>
            <a asp-action="Index" asp-controller="Home" onclick="toggleLoadingOverlay();"><i class="fa fa-home"></i>首頁</a>
        </li>
        @if (canViewDashboard)
        {
            <li>
                <a asp-action="Dashboard" asp-controller="Home" onclick="toggleLoadingOverlay();"><i class="fa-solid fa-chart-line"></i>營運儀表板</a>
            </li>
        }
        @if (auth)
        {
            <li>
                <a href="#authmenu" data-bs-toggle="collapse" aria-expanded="false" class="dropdown-toggle no-caret-down"><i class="fas fa-user-shield"></i>權限管理</a>
                <ul class="collapse list-unstyled" id="authmenu">
                    <li>
                        <a asp-action="Index" asp-controller="User" onclick="toggleLoadingOverlay();"><i class="fas fa-user-friends"></i>使用者列表</a>
                    </li>
                    <li>
                        <a asp-action="Index" asp-controller="Roles" onclick="toggleLoadingOverlay();"><i class="fa-solid fa-shield-halved" style="margin-right:5px;"></i>角色清單</a>
                    </li>
                </ul>
            </li>
        }
        @if (systemAdmin)
        {
            <li>
                <a href="#settingsmenu" data-bs-toggle="collapse" aria-expanded="false" class="dropdown-toggle no-caret-down"><i class="fas fa-cog"></i>設置</a>
                <ul class="collapse list-unstyled" id="settingsmenu">
                    <li>
                        <a asp-action="Index" asp-controller="Audit"><i class="fa fa-history" style="margin-right:5px;" onclick="toggleLoadingOverlay();"></i>歷程紀錄</a>
                    </li>
                </ul>
            </li>
        }
        @if (canViewOrders.Succeeded)
        {
            <li>
                <a asp-action="Index" asp-controller="Orders" onclick="toggleLoadingOverlay();"><i class="fas fa-file-alt"></i>訂單</a>
            </li>
        }
        @if (canViewProducts.Succeeded && canViewSuppliers.Succeeded)
        {
            <li>
                <a asp-action="Index" asp-controller="Products" onclick="toggleLoadingOverlay();"><i class="fas fa-box"></i>商品</a>
            </li>
        }
        @if (canViewCategories.Succeeded)
        {
            <li>
                <a asp-action="Index" asp-controller="Categories" onclick="toggleLoadingOverlay();"><i class="fas fa-tags"></i>商品分類</a>
            </li>
        }
    </ul>
</nav>
