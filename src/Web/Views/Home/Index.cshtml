@model CleanArchitecture.Northwind.Web.ViewModels.Home.PublicProductCatalogViewModel
@{
    ViewData["Title"] = "商品展示";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>@ViewData["Title"]</h3>
    </div>

    <form id="publicProductSearchForm" method="post" asp-action="Index" class="row g-2 mb-4">
        @Html.AntiForgeryToken()
        <input type="hidden" name="pageSize" value="@Model.Pagination.PageSize" />
        <div class="col-12 col-md-6">
            <label class="form-label" for="keyword">搜尋商品</label>
            <input id="keyword" name="keyword" value="@Model.Keyword" class="form-control" placeholder="商品名稱或分類" />
        </div>
        <div class="col-12 col-md-4">
            <label class="form-label" for="categoryId">分類</label>
            <select id="categoryId" name="categoryId" class="form-select">
                <option value="">全部分類</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.Id" selected="@(Model.CategoryId == category.Id)">@category.Name</option>
                }
            </select>
        </div>
        <div class="col-12 col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">搜尋</button>
        </div>
    </form>

    @if (Model.Items.Count == 0)
    {
        <partial name="_NoDataPartial" model="@(string.Empty)" />
    }
    else
    {
        <div class="row g-4">
            @foreach (var product in Model.Items)
            {
                <div class="col-12 col-sm-6 col-lg-4">
                    <article class="card h-100 shadow-sm">
                        @if (product.HasPicture)
                        {
                            <img src="@Url.Action("ProductImage", new { id = product.Id })" class="card-img-top object-fit-cover" style="height: 220px;" alt="@product.ProductName" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center" style="height: 220px;" aria-label="商品暫無圖片">
                                <i class="fas fa-box-open fa-3x text-secondary" aria-hidden="true"></i>
                            </div>
                        }
                        <div class="card-body">
                            <div class="text-muted small mb-1">@product.CategoryName</div>
                            <h4 class="h5 card-title">@product.ProductName</h4>
                            <p class="card-text mb-0 fw-semibold">@product.UnitPrice.ToString("C")</p>
                        </div>
                    </article>
                </div>
            }
        </div>

        <form id="publicProductPaginationForm" method="post" asp-action="Index" class="mt-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="keyword" value="@Model.Keyword" />
            <input type="hidden" name="categoryId" value="@Model.CategoryId" />
            <input type="hidden" name="pageNumber" value="@Model.Pagination.PageNumber" />
            <partial name="_PaginationPartial" model="Model.Pagination" />
        </form>
}
</div>

@section Scripts {
    <script src="~/js/pagination.js"></script>
    <script asp-add-nonce>
        window.saveOrdersScrollPosition = window.saveOrdersScrollPosition ?? (() => {});
        window.submitOrdersSearch = form => {
            if (form.dataset.isSubmitting === 'true') {
                return;
            }

            form.dataset.isSubmitting = 'true';
            $('#loadingOverlay').removeClass('d-none');
            requestAnimationFrame(() => window.setTimeout(() => form.submit(), 0));
        };

        const publicProductSearchForm = document.querySelector('#publicProductSearchForm');
        publicProductSearchForm.addEventListener('submit', event => {
            event.preventDefault();
            window.submitOrdersSearch(event.currentTarget);
        });

        window.initPagination('#publicProductPaginationForm');
    </script>
}
