@model CleanArchitecture.Northwind.Web.ViewModels.Products.StocktakeViewModel
@{
    ViewData["Title"] = "庫存盤點";
}

<div class="container mt-4">
    <h3>@ViewData["Title"]</h3>
    <p class="text-muted">@Model.ProductName，系統庫存：@Model.UnitsInStock</p>
    <form asp-action="Stocktake" method="post" class="row g-3">
        @Html.AntiForgeryToken()
        <input asp-for="ProtectedId" type="hidden" />
        <input asp-for="RowVersion" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="col-12 col-md-4">
            <label asp-for="ActualQuantity" class="form-label">實際數量</label>
            <input asp-for="ActualQuantity" class="form-control" />
            <span asp-validation-for="ActualQuantity" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Reason" class="form-label">盤點原因</label>
            <textarea asp-for="Reason" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Reason" class="text-danger"></span>
        </div>
        <div class="col-12">
            <button type="submit" class="btn btn-primary">完成盤點</button>
            <a asp-action="Details" asp-route-id="@Model.DetailsProtectedId" class="btn btn-secondary">取消</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
