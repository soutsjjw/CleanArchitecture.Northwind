@using CleanArchitecture.Northwind.Application.Features.Member.Commands.ChangePassword
@model ChangePasswordDto
@{
    ViewData["Title"] = "修改密碼";
}

<div class="container">
    <div class="row">
        <div class="col-3"></div>
        <div class="col-6">
            <div class="page-title">
                <h3>@ViewData["Title"]</h3>
            </div>
            <div class="row">
                <div class="col-lg-12">
                    <div class="card">
                        <div class="card-header">@ViewData["Title"]</div>
                        <div class="card-body">
                            <form id="frmForm" asp-controller="Member" asp-action="PasswordChange" method="post" autocomplete="off" novalidate>
                                <div class="mb-3">
                                    <label asp-for="CurrentPassword" class="form-label">目前密碼</label>
                                    <div class="input-group input-group-flat">
                                        <input asp-for="CurrentPassword" class="form-control" type="password" autocomplete="current-password" />
                                        <span class="input-group-text">
                                            <i class="fa-solid fa-eye-slash" id="toggleCurrentPassword"
                                               style="cursor: pointer" onclick="togglePassword('CurrentPassword')"></i>
                                        </span>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="NewPassword" class="form-label">新密碼</label>
                                    <div class="input-group input-group-flat">
                                        <input asp-for="NewPassword" class="form-control" type="password" autocomplete="new-password" />
                                        <span class="input-group-text">
                                            <i class="fa-solid fa-eye-slash" id="toggleNewPassword"
                                               style="cursor: pointer" onclick="togglePassword('NewPassword')"></i>
                                        </span>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="ConfirmPassword" class="form-label">確認新密碼</label>
                                    <div class="input-group input-group-flat">
                                        <input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="confirm-password" />
                                        <span class="input-group-text">
                                            <i class="fa-solid fa-eye-slash" id="toggleConfirmPassword"
                                               style="cursor: pointer" onclick="togglePassword('ConfirmPassword')"></i>
                                        </span>
                                    </div>
                                </div>
                                <div class="mb-3 text-center">
                                    <button type="submit" class="btn btn-primary" onclick="toggleLoadingOverlay()">送出</button>
                                    <a class="btn btn-outline-secondary" asp-action="Profile" onclick="toggleLoadingOverlay()">取消</a>
                                </div>
                            </form>

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-3"></div>
    </div>
</div>

