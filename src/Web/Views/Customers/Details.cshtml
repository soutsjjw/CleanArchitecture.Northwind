@model CleanArchitecture.Northwind.Web.ViewModels.Customers.CustomerDetailViewModel
@{
    ViewData["Title"] = Model.CompanyName;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>@ViewData["Title"]</h3>
        <a asp-action="Index" asp-route-keyword="@Model.Keyword" asp-route-country="@Model.CountryFilter" asp-route-city="@Model.CityFilter" asp-route-sortBy="@Model.SortBy" asp-route-sortDescending="@Model.SortDescending" asp-route-pageNumber="@Model.PageNumber" asp-route-pageSize="@Model.PageSize" class="btn btn-secondary">返回客戶清單</a>
    </div>

    <h5>客戶基本資料</h5>
    <dl class="row mb-4">
        <dt class="col-sm-3">客戶代碼</dt><dd class="col-sm-9">@DisplayValue(Model.Id)</dd>
        <dt class="col-sm-3">公司名稱</dt><dd class="col-sm-9">@DisplayValue(Model.CompanyName)</dd>
    </dl>

    <h5>聯絡資訊</h5>
    <dl class="row mb-4">
        <dt class="col-sm-3">聯絡人</dt><dd class="col-sm-9">@DisplayValue(Model.ContactName)</dd>
        <dt class="col-sm-3">職稱</dt><dd class="col-sm-9">@DisplayValue(Model.ContactTitle)</dd>
        <dt class="col-sm-3">電話</dt><dd class="col-sm-9">@DisplayValue(Model.Phone)</dd>
        <dt class="col-sm-3">傳真</dt><dd class="col-sm-9">@DisplayValue(Model.Fax)</dd>
    </dl>

    <h5>地址</h5>
    <dl class="row">
        <dt class="col-sm-3">地址</dt><dd class="col-sm-9">@DisplayValue(Model.Address)</dd>
        <dt class="col-sm-3">城市</dt><dd class="col-sm-9">@DisplayValue(Model.City)</dd>
        <dt class="col-sm-3">地址區域</dt><dd class="col-sm-9">@DisplayValue(Model.Region)</dd>
        <dt class="col-sm-3">郵遞區號</dt><dd class="col-sm-9">@DisplayValue(Model.PostalCode)</dd>
        <dt class="col-sm-3">國家</dt><dd class="col-sm-9">@DisplayValue(Model.Country)</dd>
    </dl>
</div>

@functions {
    private static string DisplayValue(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;
}
