{
  "AppConfigurationSettings": {
    "SystemName": "Clean Architecture Northwind",
    "SiteUrl": "https://localhost:7212"
  },
  "ConnectionStrings": {
    "DefaultConnection": "CAN_ConnectionString"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MailSettings": {
    "From": "souts.jjw@gmail.com",
    "Host": "localhost",
    "Port": 1025,
    "UserName": "",
    "Password": "",
    "DisplayName": "workflow"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.MSSqlServer" ],
    "MinimumLevel": "Information",
    "Filter": [
      {
        "Name": "ByExcluding",
        "Args": {
          "expression": "Message like '%swagger%'"
        }
      }
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "DataProtection": {
    "Purpose": "your_data_protection_key_that_is_at_least_50_bytes",
    "SQLPassPhrase": "your_sql_pass_phrase_key_that_is_in_environmental_variables_name_is_SQLPassPhrase"
  },
  "IdentitySettings": {
    "RequireDigit": true,
    "RequiredLength": 12,
    "MaxLength": 16,
    "RequireNonAlphanumeric": true,
    "RequireUpperCase": true,
    "RequireLowerCase": true,
    "DefaultLockoutTimeSpan": 30,
    "ConfirmEmailTokenUrl": "/Account/ConfirmEmail",
    "ForceEnableTotp": false,
    "PasswordExpirationDays": 90
  },
  "Cloudflare": {
    "SiteKey": "",
    "SecretKey": "",
    "SiteVerify": "https://challenges.cloudflare.com/turnstile/v0/siteverify"
  }
}
