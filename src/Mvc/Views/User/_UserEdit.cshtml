@using CleanArchitecture.Northwind.Application.Features.User.Queries.UserDetail
@model UserDetailDto

<form asp-action="Edit" asp-controller="User" method="post" id="frmUserEdit">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="UserId" />
    @* <input type="hidden" asp-for="UserName" />
    <input type="hidden" asp-for="Email" /> *@

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="container-fluid">
        <div class="row gy-3">
            <div class="col-12 col-md-6">
                <div class="form-group">
                    <label class="form-label text-muted">電子郵件</label>
                    <div class="form-control-plaintext">
                        @Model.Email
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6">
                <div class="form-group">
                    <br />
                    <input class="form-check-input" asp-for="EmailConfirmed" />
                    <label class="form-check-label" asp-for="EmailConfirmed">電子郵件已驗證</label>
                </div>
            </div>

            <div class="col-12 col-md-6">
                <div class="form-group">
                    <label asp-for="FullName" class="form-label">姓名</label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
            </div>
            <div class="col-12 col-md-6">
                <div class="form-group">
                    <label asp-for="IDNo" class="form-label">身分證號</label>
                    <input asp-for="IDNo" class="form-control" />
                </div>
            </div>

            <div class="col-12 col-md-6">
                <div class="form-group">
                    <label asp-for="Title" class="form-label">職稱</label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
            </div>
            <div class="w-100"></div>

            <div class="col-12 col-md-6">
                <div class="form-group">
                    <label class="form-label text-muted">部門</label>
                    <select asp-for="DepartmentId" class="form-select">
                        <option value="">@(Mvc.Common.WebConstants.SelectOptionLabel)</option>
                        @if (ViewBag.Departments != null)
                        {
                            var current = Model?.DepartmentId.ToString() ?? "";
                            foreach (var dept in ViewBag.Departments)
                            {
                                <option value="@dept.Value"
                                        selected="@(dept.Value == current ? "selected" : null)">
                                    @dept.Text
                                </option>
                            }
                        }
                    </select>
                    <span asp-validation-for="DepartmentId" class="text-danger"></span>
                </div>
            </div>
            <div class="col-12 col-md-6">
                <div class="form-group">
                    <label class="form-label text-muted">單位</label>
                    <select asp-for="OfficeId" class="form-select" data-selected="@Model.OfficeId">
                        <option value="">@(Mvc.Common.WebConstants.SelectOptionLabel)</option>
                    </select>
                    <span asp-validation-for="OfficeId" class="text-danger"></span>
                </div>
            </div>

            <div class="col-12 col-md-6">
                <div class="form-group">
                    <label class="form-label text-muted">狀態</label>
                    <select asp-for="Status"
                            asp-items="Html.GetEnumSelectList<CleanArchitecture.Northwind.Domain.Enums.Status>()"
                            class="form-select">
                    </select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>
            </div>

            <div class="col-12 col-md-6 d-flex align-items-center">
                <div class="form-group">
                    @{
                        var taipei = TimeZoneInfo.FindSystemTimeZoneById("Taipei Standard Time");
                        var localLockoutEnd = Model.LockoutEnd.HasValue
                        ? TimeZoneInfo.ConvertTimeFromUtc(Model.LockoutEnd.Value.UtcDateTime, taipei)
                        : (DateTime?)null;
                        var lockoutEndStr = localLockoutEnd?.ToString("yyyy-MM-ddTHH:mm");
                    }
                    <label class="form-label text-muted">結束鎖定時間</label>
                    <input name="LockoutEnd" type="datetime-local" class="form-control" value="@lockoutEndStr" />
                </div>
            </div>
        </div>
    </div>
</form>

@await Component.InvokeAsync("Toast")