@using CleanArchitecture.Northwind.Application.Features.User.Queries.UserDetail
@using CleanArchitecture.Northwind.Domain.Enums
@model UserDetailDto

<div class="container-fluid">
    <div class="row gy-3">
        <div class="col-12 col-md-6">
            <div class="form-group">
                <label class="form-label text-muted">電子郵件</label>
                <div class="form-control-plaintext">
                    @Model.Email
                    @if (Model.EmailConfirmed)
                    {
                        <span class="badge bg-success ms-2">已驗證</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary ms-2">未驗證</span>
                    }
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="form-group">
                <label class="form-label text-muted">姓名</label>
                <div class="form-control-plaintext">
                    @Model.FullName
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="form-group">
                <label class="form-label text-muted">身分證號</label>
                <div class="form-control-plaintext">
                    @Model.IDNo
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="form-group">
                <label class="form-label text-muted">職稱</label>
                <div class="form-control-plaintext">
                    @Model.Title
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="form-group">
                <label class="form-label text-muted">部門</label>
                <div class="form-control-plaintext">
                    @Model.DepartmentName
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="form-group">
                <label class="form-label text-muted">單位</label>
                <div class="form-control-plaintext">
                    @Model.OfficeName
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="form-group">
                <label class="form-label text-muted">狀態</label>
                <div class="form-control-plaintext">
                    @switch (Model.Status)
                    {
                        case Status.Disable:
                            <h5><span class="badge bg-danger">停用</span></h5>
                            break;
                        case Status.Enabled:
                            <h5><span class="badge bg-success">啟用</span></h5>
                            break;
                        case Status.Limit:
                            <h5><span class="badge bg-danger">受限</span></h5>
                            break;
                        case Status.Register:
                            <h5><span class="badge bg-secondary">註冊</span></h5>
                            break;
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="form-group">
                <label class="form-label text-muted">結束鎖定時間</label>
                <div class="form-control-plaintext">
                    @if (Model.LockoutEnd.HasValue)
                    {
                        <h5>
                            <span class="badge @(Model.LockoutEnd.Value > DateTime.Now ? "bg-danger" : "bg-success")">
                                @(Model.LockoutEnd?.ToLocalTime().ToString("yyyy/MM/dd HH:mm:ss"))
                            </span>
                        </h5>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
